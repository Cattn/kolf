{
  "description": "Course editor: a new course starts with a cup; the problems list flags a gate with no plate and clears when a plate is added; Test Hole plays the hole and returns; the palette adds Ice with its property panel; corner and rotate handles resize and rotate it; duplicate, nudge, undo and redo; palette search.",
  "steps": [
    { "wait": 1000 },
    { "resize": [1100, 860], "wait": 500 },
    { "click": "homeEditor" },
    { "expectHidden": "homeView", "within": 4000, "wait": 300 },
    { "expectHidden": "editorProblems", "screenshot": "01-new-course-cup.png" },
    { "activateItem": "Gate", "in": "editorPalette", "wait": 400 },
    { "expectVisible": "property_channel", "within": 2000 },
    { "expectVisible": "editorProblems", "screenshot": "02-gate-without-plate.png" },
    { "drag": [182, 182, 120, 300], "wait": 400 },
    { "activateItem": "Pressure Plate", "in": "editorPalette", "wait": 400 },
    { "expectHidden": "editorProblems", "within": 2000, "screenshot": "03-plate-added.png" },
    { "click": "editorTest" },
    { "expectHidden": "Editor", "within": 3000, "wait": 400, "screenshot": "04-testing.png" },
    { "action": "editing" },
    { "expectVisible": "Editor", "within": 3000, "wait": 400, "screenshot": "05-back-in-editor.png" },
    { "activateItem": "Ice", "in": "editorPalette", "wait": 400 },
    { "expectVisible": "propertyPanel", "within": 2000, "wait": 300, "screenshot": "06-ice-handles.png" },
    { "drag": [212, 202, 232, 222], "wait": 500 },
    { "screenshot": "07-resized.png" },
    { "drag": [182, 124, 240, 182], "wait": 500 },
    { "screenshot": "08-rotated.png" },
    { "key": "Ctrl+Z", "to": "game", "wait": 500 },
    { "screenshot": "09-rotation-undone.png" },
    { "key": "Ctrl+D", "to": "game", "wait": 400 },
    { "key": "Shift+Right", "to": "game", "wait": 200 },
    { "key": "Shift+Right", "to": "game", "wait": 500 },
    { "screenshot": "10-duplicated-and-nudged.png" },
    { "key": "Ctrl+Z", "to": "game", "wait": 500 },
    { "screenshot": "11-undo-once.png" },
    { "key": "Ctrl+Z", "to": "game", "wait": 500 },
    { "screenshot": "12-undo-twice.png" },
    { "click": "editorRedo", "wait": 500 },
    { "screenshot": "13-redo.png" },
    { "type": "gat", "into": "editorSearch", "wait": 400 },
    { "screenshot": "14-search.png" },
    { "quit": true }
  ]
}
