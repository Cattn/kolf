{
  "description": "Hub server menu: an unreachable default fails, switching to a working saved server connects, and Manage Servers opens Configure Kolf on the Servers page. Needs a local server on 127.0.0.1:13111.",
  "steps": [
    { "wait": 1500 },
    { "setConfig": { "group": "Online", "key": "servers", "value": "[{\"name\":\"Test LAN\",\"url\":\"ws://127.0.0.1:13111\"},{\"name\":\"Closed port\",\"url\":\"ws://127.0.0.1:9\"}]" } },
    { "setConfig": { "group": "Online", "key": "defaultServer", "value": "ws://127.0.0.1:9" } },
    { "click": "homeOnline", "wait": 6000 },
    { "expectVisible": "onlineServerControls" },
    { "openMenu": "onlineServerMenuPopup", "wait": 600 },
    { "screenshot": "01-menu.png", "of": "onlineServerMenuPopup" },
    { "trigger": "Test LAN", "in": "onlineServerMenuPopup", "wait": 3000 },
    { "expectHidden": "onlineServerControls", "screenshot": "02-switched.png" },
    { "click": "onlineHost", "wait": 1500 },
    { "expectVisible": "onlineLobby" },
    { "action": "mainmenu", "wait": 1000 },
    { "continueOnError": true, "clickText": "Leave Lobby", "wait": 1000 },
    { "click": "homeOnline", "wait": 2500 },
    { "openMenu": "onlineServerMenuPopup", "wait": 600 },
    { "trigger": "Manage Servers…", "in": "onlineServerMenuPopup", "wait": 2500 },
    { "screenshot": "03-manage.png", "of": "modal" },
    { "clickText": "Cancel", "wait": 600 },
    { "quit": true }
  ]
}
