{
  "description": "Configure Kolf > Servers: status for each server, Add with live address feedback, Set as Default, and the hub picks up the new default. Needs a local server on 127.0.0.1:13111.",
  "steps": [
    { "wait": 1500 },
    { "setConfig": { "group": "Online", "key": "servers", "value": "[{\"name\":\"Test LAN\",\"url\":\"ws://127.0.0.1:13111\"},{\"name\":\"Closed port\",\"url\":\"ws://127.0.0.1:9\"}]" } },
    { "action": "options_configure", "wait": 1200 },
    { "page": "Servers", "wait": 9000 },
    { "screenshot": "01-servers.png", "of": "modal" },
    { "click": "serverAdd", "wait": 800 },
    { "type": "Basement", "into": "serverEditName" },
    { "type": "192.168.50.7", "into": "serverEditAddress", "wait": 300 },
    { "screenshot": "02-add-server.png", "of": "modal" },
    { "clickText": "OK", "wait": 800 },
    { "click": "serverSetDefault", "wait": 400 },
    { "screenshot": "03-new-default.png", "of": "modal" },
    { "clickText": "OK", "wait": 1000 },
    { "click": "homeOnline", "wait": 1500 },
    { "expectVisible": "onlineHub", "screenshot": "04-hub.png" },
    { "quit": true }
  ]
}
