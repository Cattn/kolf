{
  "kolfObject": 1,
  "id": "fence",
  "name": "Electric Fence",
  "category": "obstacle",
  "help": "A barrier that switches on and off on a steady cycle. Solid and bright while on; the ball passes while it is faded.",
  "shape": {
    "type": "rect",
    "size": [
      80,
      8
    ],
    "resizable": true,
    "rotatable": true
  },
  "visual": {
    "sprite": "fence.svg",
    "layer": "ground"
  },
  "properties": {
    "cycle": {
      "type": "number",
      "label": "Cycle (seconds)",
      "min": 0.5,
      "max": 10,
      "step": 0.5,
      "default": 2
    },
    "onFraction": {
      "type": "number",
      "label": "Time on",
      "min": 0.1,
      "max": 0.9,
      "step": 0.05,
      "default": 0.5
    }
  },
  "components": [
    {
      "type": "solid"
    },
    {
      "type": "pulse",
      "period": "$cycle",
      "duty": "$onFraction"
    }
  ]
}
