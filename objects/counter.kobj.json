{
  "kolfObject": 1,
  "id": "counter",
  "name": "Counter",
  "category": "mechanism",
  "help": "Counts signals on one channel and signals another once it reaches its target. Shows its count.",
  "shape": {
    "type": "rect",
    "size": [
      34,
      22
    ],
    "resizable": false,
    "rotatable": false
  },
  "visual": {
    "sprite": "counter.svg",
    "layer": "ground"
  },
  "properties": {
    "input": {
      "type": "text",
      "label": "Counts channel",
      "default": "a",
      "maxLength": 32
    },
    "target": {
      "type": "int",
      "label": "Target",
      "min": 1,
      "max": 20,
      "default": 3
    },
    "output": {
      "type": "text",
      "label": "Then signals",
      "default": "b",
      "maxLength": 32
    }
  },
  "components": [
    {
      "type": "counter",
      "input": "$input",
      "count": "$target",
      "channel": "$output"
    }
  ]
}
