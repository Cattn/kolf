{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolf.pro/schema/kobj-1.json",
  "title": "Kolf object definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kolfObject",
    "id",
    "name",
    "category",
    "shape",
    "visual",
    "components"
  ],
  "properties": {
    "kolfObject": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "not": {
        "enum": [
          "ball",
          "course",
          "hole"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "category": {
      "enum": [
        "terrain",
        "obstacle",
        "hazard",
        "mechanism",
        "decoration",
        "course"
      ]
    },
    "help": {
      "type": "string",
      "maxLength": 500
    },
    "affectsGameplay": {
      "type": "boolean",
      "default": true
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "size"
      ],
      "properties": {
        "type": {
          "enum": [
            "rect",
            "ellipse"
          ]
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 2000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "resizable": {
          "type": "boolean",
          "default": false
        },
        "rotatable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sprite"
      ],
      "properties": {
        "sprite": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\.svg$"
        },
        "layer": {
          "enum": [
            "ground",
            "raised",
            "canopy"
          ],
          "default": "ground"
        }
      }
    },
    "properties": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9_]{0,31}$",
        "not": {
          "enum": [
            "width",
            "height",
            "rotation",
            "dummykey"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/property"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "string",
      "pattern": "^\\$[a-z][A-Za-z0-9_]{0,31}$"
    },
    "property": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "number",
            "int",
            "bool",
            "angle",
            "enum",
            "text"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "default": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 32
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "friction"
          ],
          "properties": {
            "type": {
              "const": "surface"
            },
            "friction": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 20
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "priority": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "speedCap": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 20
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "strength"
          ],
          "properties": {
            "type": {
              "const": "force"
            },
            "direction": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 359
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "strength": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "mode": {
              "oneOf": [
                {
                  "enum": [
                    "direction",
                    "attract",
                    "repel",
                    "vortex"
                  ]
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "twist": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "period": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "minimum": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "impulse"
          ],
          "properties": {
            "type": {
              "const": "boost"
            },
            "direction": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 359
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "impulse": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "cooldown": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "type": {
              "const": "hazard"
            },
            "outcome": {
              "enum": [
                "water",
                "reset-last",
                "reset-tee",
                "sink"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "on",
            "key"
          ],
          "properties": {
            "type": {
              "const": "sound"
            },
            "on": {
              "enum": [
                "boost",
                "hazard"
              ]
            },
            "key": {
              "enum": [
                "blackhole",
                "bumper",
                "hit",
                "puddle",
                "wall",
                "woohoo"
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "decor"
            }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "solid"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "on",
            "channel"
          ],
          "properties": {
            "type": {
              "const": "trigger"
            },
            "on": {
              "oneOf": [
                {
                  "enum": [
                    "occupied",
                    "enter",
                    "exit",
                    "stop"
                  ]
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "channel": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "channel",
            "action"
          ],
          "properties": {
            "type": {
              "const": "receiver"
            },
            "channel": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "action": {
              "oneOf": [
                {
                  "enum": [
                    "open",
                    "close",
                    "toggle",
                    "start",
                    "stop"
                  ]
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "mode": {
              "oneOf": [
                {
                  "enum": [
                    "latch",
                    "momentary"
                  ]
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "speed"
          ],
          "properties": {
            "type": {
              "const": "motion"
            },
            "dx": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "dy": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "speed": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "autostart": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "kind": {
              "oneOf": [
                {
                  "enum": [
                    "slide",
                    "spin",
                    "swing"
                  ]
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "arc": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 180
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [],
          "properties": {
            "type": {
              "const": "crumble"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "period"
          ],
          "properties": {
            "type": {
              "const": "pulse"
            },
            "period": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 30
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "duty": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.95
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "radius",
            "impulse"
          ],
          "properties": {
            "type": {
              "const": "blast"
            },
            "radius": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 300
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "impulse": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 10
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "mass"
          ],
          "properties": {
            "type": {
              "const": "body"
            },
            "mass": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.02,
                  "maximum": 5
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "damping": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 10
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            },
            "bounce": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "$ref": "#/$defs/binding"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
