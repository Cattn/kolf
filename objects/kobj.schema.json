{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kolf.pro/schema/kobj-1.json",
  "title": "Kolf object definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kolfObject", "id", "name", "category", "shape", "visual", "components"],
  "properties": {
    "kolfObject": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "not": { "enum": ["ball", "course", "hole"] } },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "category": { "enum": ["terrain", "obstacle", "hazard", "mechanism", "decoration", "course"] },
    "help": { "type": "string", "maxLength": 500 },
    "affectsGameplay": { "type": "boolean", "default": true },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size"],
      "properties": {
        "type": { "enum": ["rect", "ellipse"] },
        "size": { "type": "array", "items": { "type": "number", "minimum": 1, "maximum": 2000 }, "minItems": 2, "maxItems": 2 },
        "resizable": { "type": "boolean", "default": false },
        "rotatable": { "type": "boolean", "default": false }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sprite"],
      "properties": {
        "sprite": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\\.svg$" },
        "layer": { "enum": ["ground", "raised", "canopy"], "default": "ground" }
      }
    },
    "properties": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,31}$", "not": { "enum": ["width", "height", "rotation", "dummykey"] } },
      "additionalProperties": { "$ref": "#/$defs/property" }
    },
    "components": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "binding": { "type": "string", "pattern": "^\\$[a-z][A-Za-z0-9_]{0,31}$" },
    "property": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["number", "int", "bool", "angle", "enum", "text"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "values": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "minItems": 1, "maxItems": 32 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "component": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["friction"],
          "properties": {
            "type": { "const": "surface" },
            "friction": { "oneOf": [{ "type": "number", "minimum": 0.05, "maximum": 20 }, { "$ref": "#/$defs/binding" }] },
            "priority": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 10 }, { "$ref": "#/$defs/binding" }] }
          }
        },
        {
          "additionalProperties": false,
          "required": ["strength"],
          "properties": {
            "type": { "const": "force" },
            "direction": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 359 }, { "$ref": "#/$defs/binding" }] },
            "strength": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 20 }, { "$ref": "#/$defs/binding" }] }
          }
        },
        {
          "additionalProperties": false,
          "required": ["impulse"],
          "properties": {
            "type": { "const": "boost" },
            "direction": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 359 }, { "$ref": "#/$defs/binding" }] },
            "impulse": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 10 }, { "$ref": "#/$defs/binding" }] },
            "cooldown": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 600 }, { "$ref": "#/$defs/binding" }] }
          }
        },
        {
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": { "type": { "const": "hazard" }, "outcome": { "const": "water" } }
        },
        {
          "additionalProperties": false,
          "required": ["on", "key"],
          "properties": {
            "type": { "const": "sound" },
            "on": { "enum": ["boost", "hazard"] },
            "key": { "enum": ["blackhole", "bumper", "hit", "puddle", "wall", "woohoo"] }
          }
        },
        {
          "additionalProperties": false,
          "properties": { "type": { "const": "decor" } }
        }
      ]
    }
  }
}
