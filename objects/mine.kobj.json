{
  "kolfObject": 1,
  "id": "mine",
  "name": "Mine",
  "category": "hazard",
  "help": "Goes off once when a ball rolls onto it, knocking every nearby ball away. It re-arms when the hole restarts.",
  "shape": {
    "type": "ellipse",
    "size": [
      18,
      18
    ],
    "resizable": false,
    "rotatable": false
  },
  "visual": {
    "sprite": "mine.svg",
    "layer": "ground"
  },
  "properties": {
    "radius": {
      "type": "number",
      "label": "Blast radius",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 80
    },
    "power": {
      "type": "number",
      "label": "Blast power",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "default": 4
    }
  },
  "components": [
    {
      "type": "blast",
      "radius": "$radius",
      "impulse": "$power"
    }
  ]
}
