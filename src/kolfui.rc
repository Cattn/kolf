<?xml version="1.0" encoding="UTF-8"?>
<gui name="kolf"
     version="19"
     xmlns="http://www.kde.org/standards/kxmlgui/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kxmlgui/1.0
                         http://www.kde.org/standards/kxmlgui/1.0/kxmlgui.xsd">
	<MenuBar>
		<Menu name="game">
			<Action name="mainmenu" append="new_merge" />
			<Action name="online" append="new_merge" />
			<Action name="online_resync" append="new_merge" />
			<Separator />
			<Action name="savegame" append="save_merge" />
			<Action name="savegameas" append="save_merge" />
		</Menu>

		<Menu name="hole"><text>Ho&amp;le</text>
			<Action name="undoshot" />
			<Action name="resethole" />
			<Action name="skiponlinehole" />
			<Separator />
			<Menu name="go_course"><text>&amp;Go to</text>
				<Action name="nexthole" />
				<Action name="prevhole" />
				<Action name="firsthole" />
				<Action name="lasthole" />
				<Action name="randhole" />
				<Separator />
				<Action name="switchhole" />
			</Menu>
		</Menu>

		<Menu name="view"><text>&amp;View</text>
			<Action name="showinfo" />
			<Action name="showguideline" />
			<Separator />
			<Action name="balltrails" />
			<Action name="effects" />
			<Action name="plainmode" />
		</Menu>

		<Menu name="course"><text>&amp;Course</text>
			<Action name="editing" />
			<Separator />
			<Action name="newhole" />
			<Action name="clearhole" />
			<Separator />
			<Action name="course_save" />
			<Action name="course_save_as" />
			<Separator />
			<Action name="aboutcourse" />
		</Menu>

		<Menu name="settings">
			<Action name="useadvancedputting" append="save_merge"/>
			<Action name="usemouse" append="save_merge"/>
			<Action name="sound" append="save_merge"/>
			<Separator append="save_merge"/>
		</Menu>

		<Menu name="help">
			<Action name="tutorial" />
		</Menu>
	</MenuBar>

	<ToolBar name="mainToolBar">
		<Action name="mainmenu" />
		<Separator />
		<Action name="undoshot" />
		<Action name="prevhole" />
		<Action name="nexthole" />
		<Separator />
		<Action name="showinfo" />
		<Action name="course_save" />
	</ToolBar>
</gui>
